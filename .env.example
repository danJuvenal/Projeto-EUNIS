# ============================================================
# EUNIS — variáveis de ambiente (modelo)
#
# Copie para .env e preencha localmente:  cp .env.example .env
# O .env NUNCA deve ser commitado (já está no .gitignore).
# Nenhuma destas variáveis pode ser exposta no frontend.
# Tudo é opcional para rodar localmente: sem nada configurado o EUNIS usa
# SQLite + catálogo de demonstração.
# ============================================================

# ---------- Aplicação ----------
# development | production (production liga o cookie Secure)
APP_ENV=development
# Reservada para assinaturas futuras (as sessões atuais usam tokens opacos no banco). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# ---------- Banco ----------
# Vazio = SQLite em backend/eunis-dev.db (decisão D-009).
# PostgreSQL (docker-compose.yml): postgresql+psycopg://eunis:<senha>@localhost:5432/eunis
DATABASE_URL=
# Usadas pelo docker-compose.yml para criar o PostgreSQL local
POSTGRES_USER=eunis
POSTGRES_PASSWORD=
POSTGRES_DB=eunis
POSTGRES_PORT=5432

# ---------- Frontend → Backend ----------
# Origens permitidas (CORS e WebSocket de presença)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---------- Catálogo TMDb ----------
# Chave v3 (API Key) ou token de leitura v4 (começa com "eyJ").
# Crie em https://www.themoviedb.org/settings/api . Vazio = catálogo demo (D-010).
TMDB_API_KEY=
TMDB_LANGUAGE=pt-BR
TMDB_REGION=BR

# ---------- Regras de produto ----------
# D-002/D-011: exigir Premium para avaliar, comentar, publicar listas e editar bio.
# Deixe false enquanto não houver pagamento real.
PREMIUM_ENFORCEMENT=false
# Segundos sem heartbeat até o usuário sair da lista de online
PRESENCE_TIMEOUT_SECONDS=70

# ---------- IA (Fase 9) — provider ainda não definido ----------
AI_API_KEY=

# ---------- Pagamentos (Fase 17) — provedor ainda não definido ----------
PAYMENT_API_KEY=
