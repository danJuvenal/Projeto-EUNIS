# ============================================================
# EUNIS — variáveis de ambiente (modelo)
#
# Copie para .env e preencha localmente:  cp .env.example .env
# O .env NUNCA deve ser commitado (já está no .gitignore).
# Nenhuma destas variáveis pode ser exposta no frontend.
# Os nomes finais serão confirmados em cada fase de implementação.
# ============================================================

# ---------- Aplicação ----------
APP_ENV=development
# Chave para assinar tokens/sessões. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# ---------- Banco (Fase 3) ----------
# Ex.: postgresql+psycopg://usuario:senha@localhost:5432/eunis
DATABASE_URL=

# ---------- Frontend → Backend ----------
# Origem(ns) permitida(s) no CORS do backend
CORS_ORIGINS=http://localhost:5173

# ---------- Catálogo TMDb (Fase 6) ----------
TMDB_API_KEY=

# ---------- IA (Fase 9) — provider ainda não definido ----------
AI_API_KEY=

# ---------- Pagamentos (Fase 17) — provedor ainda não definido ----------
PAYMENT_API_KEY=
